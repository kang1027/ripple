# ---- 필수 ----
ENV=dev
# 프로필 사진 URL 앞부분. TestFlight에선 https 도메인
PUBLIC_BASE_URL=http://localhost:8000
# python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
# 위와 같은 방법으로 별도 생성
PHONE_HMAC_SECRET=
# 시뮬레이터용 로그인. TestFlight 배포 서버에선 false
ALLOW_DEV_LOGIN=true

# 로컬 실행 시 (docker-compose는 자동 설정)
DATABASE_URL=sqlite+aiosqlite:///./ripple.db
REDIS_URL=redis://localhost:6379/0
RUN_WORKER_INLINE=true

# ---- Kakao ----
# 카카오 디벨로퍼스 > 앱 > 앱 ID (숫자)
KAKAO_APP_ID=
# 동네 이름(행정동) 표시용
KAKAO_REST_API_KEY=

# ---- Apple ----
APPLE_BUNDLE_ID=com.kdh.ripple
APPLE_TEAM_ID=GGR9HG6DB8
# Sign in with Apple 키 (탈퇴 시 토큰 해지용)
APPLE_KEY_ID=
# .p8 내용, 줄바꿈은 \n
APPLE_PRIVATE_KEY=

# ---- 앱푸시 (APNs) ----
# Apple Developer > Keys 에서 만든 APNs 키. APPLE_TEAM_ID를 같이 씀
APNS_KEY_ID=
# .p8 내용(줄바꿈은 \n) 또는 파일 경로 중 하나
APNS_PRIVATE_KEY=
APNS_KEY_PATH=

# ---- 번호인증 ----
# console(로그 출력) | sendon (센드온 허용 IP에 이 서버 IP 등록 필요)
SMS_PROVIDER=console
SENDON_USER_ID=
SENDON_API_KEY=
# 등록된 발신번호
SENDON_SENDER=
# 심사용 데모 번호 (문자 발송 없이 DEMO_CODE로 통과)
DEMO_PHONE=
DEMO_CODE=000000

# ---- 토픽 AI ----
# rule(키워드 사전) | claude(Claude API) | llm(OpenAI 호환, Ollama 등)
TOPIC_CLASSIFIER=rule
# TOPIC_CLASSIFIER=claude 일 때
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
# OpenAI 호환 엔드포인트 (Ollama 등)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b
# 센드온 허용 IP 밖에서 돌릴 때 허용된 서버를 거침. 예: socks5://127.0.0.1:18080 (ssh -D). 허용된 서버에선 비워 둠
SENDON_PROXY=
